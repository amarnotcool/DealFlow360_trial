# Normalize line endings: LF in the repo, LF on checkout everywhere.
# This kills the CRLF/LF phantom-diff noise for good.
* text=auto eol=lf

# Binary files: never normalize, never diff as text.
# (None tracked today — this is future-proofing.)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
